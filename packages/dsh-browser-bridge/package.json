{
  "name": "@sssonamuuu/dsh-browser-bridge",
  "version": "0.1.3",
  "description": "DSH browser bridge: inspect and debug the user's real Chrome/Edge tabs through a local browser extension bridge.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "docs",
    "icon.png"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "browser",
    "chrome",
    "edge",
    "devtools"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "author": "sssonamuuu",
  "repository": {
    "type": "git",
    "url": "https://github.com/sssonamuuu/dsh-brower-use.git",
    "directory": "packages/dsh-browser-bridge"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  }
}
