{
  "name": "dsh-browser-bridge",
  "version": "0.1.1",
  "description": "DSH host plugin: inspect and debug the user's real Chrome/Edge tabs through a local browser extension bridge",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "lib/client.js"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "browser",
    "chrome",
    "edge",
    "devtools"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
